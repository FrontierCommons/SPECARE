NODE_ENV=test
PORT=3000
# Must point at a disposable database with "test" in its name — the test
# harness (test/setup.ts) truncates every table before each test and will
# refuse to run against anything that doesn't look like a test database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sper_test
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_min32
JWT_REFRESH_SECRET=change_me_to_another_long_random_min32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
MAGIC_LINK_TTL=15m
INVITE_CODE_TTL_HOURS=72
APP_DEEPLINK_BASE=https://sper.app/invite
EMAIL_FROM=care@sper.app

# --- Push: APNs (iOS), all optional; log-only if unset ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.sper.mobile
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false

# --- Push: FCM (Android), all optional; log-only if unset ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Email fallback (SMTP), optional; log-only if unset ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
