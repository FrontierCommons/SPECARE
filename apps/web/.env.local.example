# Point the web app at your running API server.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Public half of the API's VAPID key pair (apps/api/.env VAPID_PUBLIC_KEY) —
# safe to expose, it's how the browser proves push subscriptions to our
# server, not a secret. Must match the API's key or subscribing will fail.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
