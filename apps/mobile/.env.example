# Point the app at your running API server. Uncomment exactly one option
# below depending on how you're testing.

# Android emulator (same machine as the API server): 10.0.2.2 is the
# emulator's alias for the host machine's localhost.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Physical device over Wi-Fi: point at this machine's LAN IP so the phone
# can reach the API server directly (run `ipconfig`/`ifconfig` to find it).
# EXPO_PUBLIC_API_URL=http://<your-lan-ip>:3000/api/v1

# If the phone is on a network that isolates devices from each other (e.g. a
# guest Wi-Fi network), tunnel the API instead and use the forwarding URL:
#   ngrok http 3000
#   EXPO_PUBLIC_API_URL=https://your-subdomain.ngrok-free.app/api/v1
